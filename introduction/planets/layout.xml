<Layout xmlns="urn:speedata.de/2021/xts/en"
    xmlns:sd="urn:speedata.de/2021/xtsfunctions/en">
    <StyleSheet>
      body {
        font-family: serif;
      }
      p {
        font-size: 8pt;
        line-height: 10pt;
      }
      .title {
        font-size: 12pt;
        line-height: 16pt;
      }
    </StyleSheet>

    <PageFormat width="150mm" height="200mm"/>
    <SetGrid width="4mm" height="14pt"/>

    <DefineMasterPage name="right page" test="sd:odd( sd:current-page() )" margin="1cm 1cm 1cm 2cm">
      <AtPageShipout>
        <PlaceObject column="1" row="{ sd:number-of-rows() - 1}">
          <TextBlock>
            <Paragraph style="text-align:right;"><Value select="concat('Page ',sd:current-page(), ' of ',sd:last-page-number())"/></Paragraph>
          </TextBlock>
        </PlaceObject>
      </AtPageShipout>
    </DefineMasterPage>

    <DefineMasterPage name="left page" test="sd:even( sd:current-page() )" margin="1cm 2cm 1cm 1cm">
      <AtPageShipout>
        <PlaceObject column="1" row="{ sd:number-of-rows() - 1}">
          <TextBlock>
            <Paragraph style="text-align: left;"><Value select="concat('Page ',sd:current-page(), ' of ',sd:last-page-number())"/></Paragraph>
          </TextBlock>
        </PlaceObject>
      </AtPageShipout>
    </DefineMasterPage>

    <Record match="tableofcontents">
        <SetVariable variable="tocloaded" select="true()"/>
        <PlaceObject column="0mm" row="0mm">
            <TextBlock>
                <Bookmark level="1" select="'Contents'" open="yes"/>
            </TextBlock>
        </PlaceObject>
        <PlaceObject column="3">
          <TextBlock>
            <Paragraph class="title">
              <Value>Contents</Value>
            </Paragraph>
          </TextBlock>
        </PlaceObject>
        <NextRow/>
        <PlaceObject column="3">
          <TextBlock width="20">
            <ForAll select="planetlisting">
              <Paragraph style="margin: 0pt;">
                <A link="{@name}">
                  <Value select="@name" />
                  <Value>, page </Value>
                  <Value select="@pagenumber" />
                </A>
              </Paragraph>
            </ForAll>
          </TextBlock>
        </PlaceObject>
      </Record>


    <Record match="planets">
      <SetVariable variable="column" select="2" />

      <!-- this calls 'tableofcontents' if the file is found on the harddrive (second run)  -->
      <SetVariable variable="tocloaded" select="false()"/>
      <LoadXML name="toc"/>
      <Switch>
        <Case test="not($tocloaded)">
          <!-- first run: the file does not exist yet. Reserve the page anyway,
               so the planets get the same page numbers in both runs. -->
          <PlaceObject column="3">
            <TextBlock>
              <Paragraph class="title">
                <Value>Contents</Value>
              </Paragraph>
            </TextBlock>
          </PlaceObject>
        </Case>
      </Switch>

      <SetVariable variable="contents"/>
      <ClearPage/>
      <ProcessNode select="planet" />

      <SaveXML name="toc" elementname="tableofcontents" select="$contents" />
      <!--
        this is the structure written:

        <tableofcontents>
          <planetlisting pagenumber="2" name="Mercury"/>
          <planetlisting pagenumber="3" name="Venus"/>
          <planetlisting pagenumber="4" name="Earth"/>
          <planetlisting pagenumber="5" name="Mars"/>
          <planetlisting pagenumber="6" name="Jupiter"/>
          <planetlisting pagenumber="7" name="Saturn"/>
          <planetlisting pagenumber="8" name="Uranus"/>
          <planetlisting pagenumber="9" name="Neptune"/>
        </tableofcontents>

      -->
    </Record>

    <Record match="planet">
      <!-- Save the name and the page number for later use -->
      <SetVariable variable="contents">
        <CopyOf select="$contents" />
        <Element name="planetlisting">
          <Attribute name="name" select=" @name " />
          <Attribute name="pagenumber" select=" sd:current-page()" />
        </Element>
      </SetVariable>

      <PlaceObject column="0mm" row="0mm">
        <TextBlock>
            <Bookmark level="1" select="@name" open="yes"/>
        </TextBlock>
      </PlaceObject>

      <PlaceObject column="1">
        <TextBlock>
          <Action>
            <Mark select="@name" pdftarget="yes" />
          </Action>
          <Paragraph>
            <Value select="@name" />
          </Paragraph>
        </TextBlock>
      </PlaceObject>


      <ProcessNode select="image" />
      <ProcessNode select="moons" />
      <ProcessNode select="description" />

      <ClearPage />
    </Record>

    <Record match="url">
      <PlaceObject column="{ $column }">
        <TextBlock width="29">
          <Paragraph class="title">
            <Value>URL: </Value>
            <A href="{ string(.) }"><Value select="string(.)" /></A>
          </Paragraph>
        </TextBlock>
      </PlaceObject>

    </Record>

    <Record match="image">
      <NextRow rows="2" />
      <PlaceObject column="{ $column }">
        <Image width="10" href="images-rgb/{.}" />
      </PlaceObject>
    </Record>

    <Record match="moons">
      <PlaceObject column="18">
        <TextBlock width="7">
          <Paragraph>
            <B><Value>Moons</Value></B>
            <Ul>
              <ForAll select="moon">
                <Li><Value select="."/></Li>
              </ForAll>
            </Ul>
            </Paragraph>
        </TextBlock>
      </PlaceObject>
      <NextRow rows="2" />
    </Record>

    <Record match="description">
      <PlaceObject column="{ $column }">
        <TextBlock>
          <Paragraph>
            <Value select="normalize-space(string(.))" />
          </Paragraph>
        </TextBlock>
      </PlaceObject>
    </Record>

</Layout>
