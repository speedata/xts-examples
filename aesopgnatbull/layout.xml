<Layout xmlns="urn:speedata.de/2021/xts/en" xmlns:sd="urn:speedata.de/2021/xtsfunctions/en">

  <StyleSheet>
      @font-face { font-family: "Fauna One"; src: url("fonts/FaunaOne-Regular.ttf");}
      @font-face { font-family: "Playfair Display"; src: url("fonts/PlayfairDisplay-Regular.ttf");}
      p {
        color: white ;
        font-size: 9pt;
        line-height: 17pt;
        font-family: "Fauna One";
        margin: 1em 0;
      }

      .heading {
        font-size: 40pt;
        line-height: 48pt;
        font-family: "Playfair Display";
      }
  </StyleSheet>

  <PageFormat width="210mm" height="140mm" />


  <DefineMasterPage name="first" test="sd:current-page() = 1" margin="1cm">
    <AtPageCreation>
      <PlaceObject column="-2mm" row="-2mm">
        <Image width="214mm" href="img/forest.jpg" />
      </PlaceObject>
    </AtPageCreation>
  </DefineMasterPage>

  <Record match="data">
    <PlaceObject row="2" column="3">
      <TextBlock width="10">
        <Paragraph class="heading">
          <Value select="upper-case(story/@title)" />
        </Paragraph>
      </TextBlock>
    </PlaceObject>
    <PlaceObject column="3">
      <TextBlock width="11">
        <ForAll select="story/p">
          <Paragraph>
            <Value select="." />
          </Paragraph>
        </ForAll>
      </TextBlock>
    </PlaceObject>
  </Record>
</Layout>
